[Unit]
Description=SG Tech Pulse salary result page (FastAPI/uvicorn)
After=network.target

[Service]
Type=simple
User=sgpulse
Group=sgpulse
WorkingDirectory=/opt/sg-pulse
EnvironmentFile=/etc/sg-pulse.env
ExecStart=/opt/sg-pulse/venv/bin/uvicorn app:app --host 127.0.0.1 --port 8020
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
